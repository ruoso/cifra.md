{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ruoso/cifra.md/schema/cifra.schema.json",
  "title": "cifra.md parsed document",
  "description": "The result of reading a cifra.md document (spec §0.4). Everything a conforming reader produces, and everything a canonical writer needs.",
  "type": "object",
  "required": ["title", "properties", "sections", "blocks", "sung", "sungAt", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": ["string", "null"], "minLength": 1, "description": "The text of the level-1 heading that is the first non-blank line, or null when there is none or its text is empty (§1.4.1)." },
    "properties": {
      "type": "array",
      "description": "The property list under the title, in order of each key's first appearance, each with the value of its last appearance (§1.4.2). Order is significant.",
      "items": {
        "type": "object",
        "required": ["key", "value"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9_-]+$", "description": "Lower-cased." },
          "value": { "type": "string", "description": "The rest of the line after the colon and the spaces after it; may be empty." }
        }
      }
    },
    "sections": { "type": "array", "items": { "$ref": "#/$defs/Section" } },
    "blocks": { "type": "array", "items": { "$ref": "#/$defs/Block" } },
    "sung": { "type": "boolean", "description": "Whether the document reads words (§4.2). Bars are numbered only when false." },
    "sungAt": { "type": ["integer", "null"], "minimum": 1, "description": "The 1-based line that made the document sung, or null (not sung, or forced by the `words` property)." },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/Diagnostic" } }
  },
  "$defs": {
    "Section": {
      "type": "object",
      "required": ["name", "heading", "anchor", "body", "groups"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Heading text, trimmed, with runs of spaces collapsed to one, a Markdown closing sequence removed, and any anchor and count removed; empty for content before the first heading (§1.7)." },
        "heading": {
          "enum": ["markdown", "bracket", "label", null],
          "description": "How the section was headed: `## Name`, `[Name]`, `Name:`, or no heading (§1.7)."
        },
        "anchor": { "type": ["integer", "null"], "minimum": 1, "description": "Bar number stated on the heading (§1.7.4)." },
        "times": { "type": "integer", "minimum": 1, "description": "Count on the heading: the section is played this many times (§1.7.4)." },
        "body": {
          "type": "array",
          "description": "Notes and music in document order (§1.9).",
          "items": { "oneOf": [{ "$ref": "#/$defs/NotesPart" }, { "$ref": "#/$defs/MusicPart" }, { "$ref": "#/$defs/VerbatimPart" }] }
        },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/RepeatGroup" }, "description": "Repeat groups paired within this section (§3.2)." }
      }
    },
    "NotesPart": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "notes" },
        "text": { "type": "string", "description": "Lines outside any fence, as prepared by §1.3, joined by newlines; no blank line at either end." }
      }
    },
    "VerbatimPart": {
      "type": "object",
      "description": "A fence with an info string other than empty or `cifra`: kept as text (§1.9).",
      "required": ["type", "info", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "verbatim" },
        "info": { "type": "string", "description": "The info string, trimmed, ASCII letters lower-cased (§1.9)." },
        "text": { "type": "string", "description": "The lines between the fences, as prepared by §1.3, joined by newlines." }
      }
    },
    "MusicPart": {
      "type": "object",
      "required": ["type", "lines"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "music" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/Line" }, "description": "Empty for an empty fence." }
      }
    },
    "Line": {
      "oneOf": [
        { "$ref": "#/$defs/ChartLine" },
        { "$ref": "#/$defs/SungLine" },
        { "$ref": "#/$defs/LyricLine" },
        { "$ref": "#/$defs/BreakLine" },
        { "$ref": "#/$defs/AnnotationLine" }
      ]
    },
    "ChartLine": {
      "type": "object",
      "required": ["kind", "measures", "closeBar"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "chart" },
        "measures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Measure" } },
        "closeBar": { "$ref": "#/$defs/BarLine" },
        "run": { "const": true, "description": "The line has no bar lines: a run of chords, not a bar (§2.1)." },
        "times": { "type": "integer", "minimum": 1, "description": "The line's count, from a count token ending a line with no repeat group (§3.3)." }
      }
    },
    "SungLine": {
      "type": "object",
      "required": ["kind", "measures", "closeBar", "forced"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "sung" },
        "measures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Measure" } },
        "closeBar": { "$ref": "#/$defs/BarLine" },
        "times": { "type": "integer", "minimum": 1 },
        "forced": { "type": "boolean", "description": "The lyric line carried a `>` marker (§4.3)." }
      }
    },
    "LyricLine": {
      "type": "object",
      "required": ["kind", "text", "forced"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "lyric" },
        "text": { "type": "string" },
        "forced": { "type": "boolean" }
      }
    },
    "AnnotationLine": {
      "type": "object",
      "description": "A `//` line inside a music fence (§1.9).",
      "required": ["kind", "text"],
      "additionalProperties": false,
      "properties": { "kind": { "const": "annotation" }, "text": { "type": "string" } }
    },
    "BreakLine": {
      "type": "object",
      "description": "A run of blank lines between two lines of a fence's music (§4.5).",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": { "kind": { "const": "break" } }
    },
    "BarLine": {
      "enum": ["|", "||", null],
      "description": "The bar line written at this position, or null for none (§2.2). Repeat marks against a bar line are items, not part of it."
    },
    "Measure": {
      "type": "object",
      "required": ["bar", "items"],
      "additionalProperties": false,
      "properties": {
        "bar": { "$ref": "#/$defs/BarLine", "description": "The bar line before this measure." },
        "column": { "type": "integer", "minimum": 0, "description": "Column of the bar line, on a sung line." },
        "anchor": { "type": "integer", "minimum": 1, "description": "Bar number stated in this measure (§2.8)." },
        "number": { "type": "integer", "minimum": 1, "description": "Bar number, counted or stated; only in an unsung document." },
        "stated": { "type": "boolean", "description": "Whether `number` was stated rather than counted." },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Item" } }
      }
    },
    "Item": {
      "oneOf": [
        { "$ref": "#/$defs/ChordItem" },
        { "$ref": "#/$defs/RepeatItem" },
        { "$ref": "#/$defs/NoChordItem" },
        { "$ref": "#/$defs/BeatItem" },
        { "$ref": "#/$defs/MarkItem" },
        { "$ref": "#/$defs/CountItem" },
        { "$ref": "#/$defs/EndingItem" },
        { "$ref": "#/$defs/UnknownItem" },
        { "$ref": "#/$defs/LeadItem" }
      ]
    },
    "ItemPlacement": {
      "description": "Present on items of a sung line only (§4.4).",
      "properties": {
        "column": { "type": "integer", "minimum": 0 },
        "words": { "type": "string" }
      }
    },
    "ChordItem": {
      "type": "object",
      "required": ["type", "symbol", "index", "key", "chord"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "chord" },
        "symbol": { "type": "string", "description": "The chord symbol as written." },
        "index": { "type": "integer", "minimum": 1, "description": "Footnote index; 1 for the bare symbol (§2.4)." },
        "key": { "type": "string", "description": "The voicing key: symbol, or symbol[index]." },
        "chord": { "oneOf": [{ "$ref": "#/$defs/Chord" }, { "type": "null" }], "description": "The canonical chord, or null when the symbol does not parse (then the item would be unknown; kept nullable for readers that skip §5)." },
        "ambiguities": { "type": "array", "items": { "$ref": "#/$defs/Ambiguity" } },
        "column": { "type": "integer", "minimum": 0 },
        "words": { "type": "string" }
      }
    },
    "NoChordItem": {
      "type": "object",
      "description": "The N.C. mark: no chord here (§2.6).",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "nochord" },
        "column": { "type": "integer", "minimum": 0 },
        "words": { "type": "string" }
      }
    },
    "BeatItem": {
      "type": "object",
      "description": "A beat mark, `/`, `.` or `-` (§2.3).",
      "required": ["type", "mark"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "beat" },
        "mark": { "enum": ["/", ".", "-"] },
        "column": { "type": "integer", "minimum": 0 },
        "words": { "type": "string" }
      }
    },
    "RepeatItem": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "repeat" },
        "column": { "type": "integer", "minimum": 0 },
        "words": { "type": "string" }
      }
    },
    "MarkItem": {
      "type": "object",
      "required": ["type", "open", "notation"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "mark" },
        "open": { "type": "boolean" },
        "notation": { "enum": ["bracket", "barline"] },
        "column": { "type": "integer", "minimum": 0 },
        "words": { "type": "string" }
      }
    },
    "CountItem": {
      "type": "object",
      "required": ["type", "times"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "count" },
        "times": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 0 },
        "words": { "type": "string" }
      }
    },
    "EndingItem": {
      "type": "object",
      "required": ["type", "number"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "ending" },
        "number": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 0 },
        "words": { "type": "string" }
      }
    },
    "UnknownItem": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "unknown" },
        "text": { "type": "string" },
        "column": { "type": "integer", "minimum": 0 },
        "words": { "type": "string" }
      }
    },
    "LeadItem": {
      "type": "object",
      "description": "Words before the first item of a sung line (§4.4).",
      "required": ["type", "words"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "lead" },
        "column": { "const": 0 },
        "words": { "type": "string" }
      }
    },
    "Position": {
      "type": "object",
      "required": ["part", "line", "measure", "item"],
      "additionalProperties": false,
      "properties": {
        "part": { "type": "integer", "minimum": 0, "description": "Index into Section.body." },
        "line": { "type": "integer", "minimum": 0 },
        "measure": { "type": "integer", "minimum": 0 },
        "item": { "type": "integer", "minimum": 0 }
      }
    },
    "RepeatGroup": {
      "type": "object",
      "required": ["open", "close", "count", "endings"],
      "additionalProperties": false,
      "properties": {
        "open": { "$ref": "#/$defs/Position" },
        "close": { "$ref": "#/$defs/Position" },
        "count": { "type": "integer", "minimum": 1, "description": "Times played in total (§3.3)." },
        "countItem": { "$ref": "#/$defs/Position" },
        "endings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["number", "at"],
            "additionalProperties": false,
            "properties": { "number": { "type": "integer", "minimum": 1 }, "at": { "$ref": "#/$defs/Position" } }
          }
        }
      }
    },
    "Note": {
      "type": "object",
      "required": ["letter", "accidental"],
      "additionalProperties": false,
      "properties": {
        "letter": { "enum": ["A", "B", "C", "D", "E", "F", "G"] },
        "accidental": { "type": "integer", "minimum": -2, "maximum": 2 }
      }
    },
    "Pitch": {
      "type": "object",
      "required": ["note", "octave"],
      "additionalProperties": false,
      "properties": { "note": { "$ref": "#/$defs/Note" }, "octave": { "type": "integer" } }
    },
    "Chord": {
      "type": "object",
      "description": "The canonical chord model (§5.2).",
      "required": ["root", "quality", "extensions", "bass"],
      "additionalProperties": false,
      "properties": {
        "root": { "$ref": "#/$defs/Note" },
        "quality": { "enum": ["major", "minor", "dim", "aug", "sus2", "sus4", "power"] },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["degree", "alter"],
            "additionalProperties": false,
            "properties": {
              "degree": { "enum": [2, 4, 5, 6, 7, 9, 11, 13] },
              "alter": { "type": "integer", "minimum": -2, "maximum": 2 }
            }
          }
        },
        "bass": { "oneOf": [{ "$ref": "#/$defs/Note" }, { "type": "null" }] }
      }
    },
    "Ambiguity": {
      "type": "object",
      "required": ["kind", "chosen", "alternative"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["sevenPlus", "bareNine", "degreeSign", "bareFour"] },
        "chosen": { "type": "string" },
        "alternative": { "type": "string" }
      }
    },
    "Tuning": {
      "type": "object",
      "required": ["text", "pitches", "id"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "description": "Each pitch as written, its letter uppercase, joined by single spaces (§6.2)." },
        "pitches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Pitch" } },
        "id": { "type": "string", "description": "Identity by sound: MIDI numbers joined by spaces (§6.3)." }
      }
    },
    "Block": {
      "type": "object",
      "required": ["label", "tuning", "voicings", "notes"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "description": "The variation name, trimmed, runs of spaces collapsed; empty for the default `Voicings` block (§7.3)." },
        "tuning": { "$ref": "#/$defs/Tuning" },
        "voicings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "symbol", "index", "frets"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string" },
              "symbol": { "type": "string" },
              "index": { "type": "integer", "minimum": 1 },
              "frets": { "type": "array", "minItems": 1, "items": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 99 }, { "const": "x" }] } },
              "fingers": {
                "type": "array",
                "minItems": 1,
                "description": "Optional fingering, one position per string (§7.5.1): 1 to 4, \"T\" for the thumb, null for a string the hand does not fret.",
                "items": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 4 }, { "const": "T" }, { "type": "null" }] }
              }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" }, "description": "The block's lines that are neither blank nor list items, in order, as prepared by §1.3." }
      }
    },
    "Diagnostic": {
      "type": "object",
      "required": ["code", "message", "line"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "line": { "type": "integer", "minimum": 1, "description": "1-based line in the document." },
        "text": { "type": "string" }
      }
    }
  }
}
